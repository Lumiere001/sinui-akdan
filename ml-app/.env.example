# .env.example — 로컬 개발 기본값. 실제 .env 는 git 제외. 운영은 Render 환경변수.
MODEL_MODE=ml
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=gps-anomaly-detection
MODEL_NAME=gps-anomaly-model
CANARY_ENABLED=true
CANARY_RATIO=0.1
LOW_CONFIDENCE_THRESHOLD=0.65
LOW_CONFIDENCE_LIMIT=5

# 드리프트 → GitHub Issue (선택)
GH_TOKEN=
GH_REPO=Lumiere001/sinui-akdan

# Google Sheets 로깅 (선택)
GOOGLE_SHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=google_key.json
